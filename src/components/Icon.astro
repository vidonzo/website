---
import { filledIcons, strokeIcons, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const filled = filledIcons[name as keyof typeof filledIcons];
const stroke = strokeIcons[name as keyof typeof strokeIcons];

if (!filled && !stroke) throw new Error(`Icon: unknown name "${name}"`);
---

<svg viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false">
  {
    filled ? (
      <path d={filled} fill="currentColor" />
    ) : (
      <path
        d={stroke}
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
</svg>

<style>
  svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    flex: none;
  }
</style>
