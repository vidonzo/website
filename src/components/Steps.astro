---
import Reveal from './Reveal.astro';

interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ol class="steps">
  {
    items.map((item, index) => (
      <Reveal as="li" delay={index}>
        <span class="num" aria-hidden="true">{index + 1}</span>
        <h3>{item.title}</h3>
        <p>{item.body}</p>
      </Reveal>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps :global(li) {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding-block-start: var(--space-lg);
  }

  /* A rule that runs from each number to the next, so the three read as a
     sequence rather than three unrelated cards. */
  .steps :global(li)::before {
    content: '';
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline: 0;
    block-size: 1px;
    background: linear-gradient(
      to right,
      var(--color-stroke-strong),
      color-mix(in srgb, var(--color-stroke) 30%, transparent)
    );
  }

  .steps :global(li:last-child)::before {
    background: var(--color-stroke-strong);
  }

  .num {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    margin-block-start: -1.25rem;
    margin-block-end: var(--space-xs);
    border-radius: 50%;
    background: var(--gradient-aurora-button);
    color: #fff;
    font-family: var(--font-latin);
    font-size: var(--text-sm);
    font-weight: 800;
    box-shadow: 0 0.5rem 1.5rem color-mix(in srgb, var(--color-primary) 40%, transparent);
  }

  h3 {
    font-size: var(--text-lg);
  }

  p {
    color: var(--color-text-mid);
    line-height: 1.65;
  }
</style>
