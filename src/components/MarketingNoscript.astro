---
import { marketing } from '../config/marketing';

const { gtmContainerId } = marketing;
---

{
  gtmContainerId && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      />
    </noscript>
  )
}
