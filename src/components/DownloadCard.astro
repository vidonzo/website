---
import GlassCard from './GlassCard.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  note: string;
  icon: IconName;
  /** Brand tint behind the glyph. */
  tone: 'android' | 'apple' | 'tv' | 'windows' | 'desktop';
  /**
   * First link is the primary action; the rest are alternates. A link with
   * `sealed` instead of `href` is gated: it opens ApkGate rather than
   * navigating, and its destination is not in the markup. See config/apk-gate.
   */
  links?: { label: string; href?: string; external?: boolean; sealed?: string }[];
  /** Whole card becomes the link when there is exactly one destination. */
  href?: string;
  comingSoon?: string;
  /** Matches a `platform` value from the OS sniff, for the "recommended" group. */
  platform?: string;
}

const { title, note, icon, tone, links = [], href, comingSoon, platform } = Astro.props;
const disabled = Boolean(comingSoon);
---

<GlassCard
  class:list={['download-card', { disabled }]}
  href={disabled ? undefined : href}
  padding="lg"
  data-platform={platform}
  aria-disabled={disabled ? 'true' : undefined}
>
  <span class:list={['glyph', tone]} aria-hidden="true">
    <Icon name={icon} />
  </span>

  <div class="body">
    <h3>{title}</h3>
    <p>{note}</p>

    {
      comingSoon ? (
        <span class="badge">{comingSoon}</span>
      ) : links.length > 0 ? (
        <span class="links">
          {links.map((link, index) =>
            link.sealed ? (
              <button
                type="button"
                data-apk={link.sealed}
                aria-haspopup="dialog"
                class:list={[{ primary: index === 0 }]}
              >
                {link.label}
              </button>
            ) : (
              <a
                href={link.href}
                class:list={[{ primary: index === 0 }]}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ),
          )}
        </span>
      ) : null
    }
  </div>
</GlassCard>

<style>
  .download-card {
    block-size: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
  }

  .glyph {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--radius-md);
    color: #fff;
  }

  .glyph :global(svg) {
    inline-size: 1.6rem;
    block-size: 1.6rem;
  }

  .android {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  }

  .tv {
    background: linear-gradient(135deg, var(--color-accent-pink), var(--color-primary));
  }

  .apple {
    background: linear-gradient(135deg, #3a3d4d, #14161f);
  }

  .desktop {
    background: linear-gradient(135deg, var(--color-secondary), var(--color-primary));
  }

  .windows {
    background: linear-gradient(135deg, #2e6eea, var(--color-secondary));
  }

  .body {
    display: grid;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  h3 {
    font-size: var(--text-md);
  }

  p {
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-sm);
  }

  .links :is(a, button) {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    padding-inline: var(--space-md);
    border: 1px solid var(--color-stroke-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: border-color var(--duration) var(--ease), background-color var(--duration) var(--ease);
  }

  .links button {
    background: none;
    cursor: pointer;
  }

  /* Set by ApkGate while it checks a remembered code. */
  .links button[data-busy] {
    cursor: progress;
    opacity: 0.7;
  }

  .links :is(a, button).primary {
    border-color: transparent;
    background: var(--gradient-aurora-button);
    color: #fff;
  }

  .links :is(a, button):not(.primary):is(:hover, :focus-visible) {
    border-color: var(--color-secondary);
    background: color-mix(in srgb, var(--color-secondary) 12%, transparent);
  }

  .badge {
    justify-self: start;
    margin-block-start: var(--space-sm);
    padding: 0.3rem var(--space-sm);
    border: 1px solid var(--color-stroke);
    border-radius: 999px;
    color: var(--color-text-subtle);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .disabled {
    opacity: 0.62;
  }
</style>
