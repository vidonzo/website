---
// Scroll-triggered entrance. Progressive enhancement in both directions:
// without JS the content is simply visible, and with reduced-motion the
// observer never runs.
interface Props {
  /** Stagger within a group, in steps of 70ms. */
  delay?: number;
  as?: string;
  class?: string;
  [key: string]: unknown;
}

const { delay = 0, as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag
  class:list={['reveal', className]}
  data-reveal
  style={delay ? `--reveal-delay: ${delay * 70}ms` : undefined}
  {...rest}
>
  <slot />
</Tag>

<style>
  /* Hidden only once the script has claimed the page, so a failed or blocked
     bundle leaves readable content rather than an empty screen. */
  :global(html[data-reveal-ready]) .reveal {
    opacity: 0;
    transform: translateY(1.5rem);
    transition:
      opacity var(--duration-slow) var(--ease) var(--reveal-delay, 0ms),
      transform var(--duration-slow) var(--ease) var(--reveal-delay, 0ms);
  }

  :global(html[data-reveal-ready]) .reveal.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html[data-reveal-ready]) .reveal {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (motionOk && 'IntersectionObserver' in window) {
    document.documentElement.setAttribute('data-reveal-ready', '');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      // Fire a little before the element reaches the fold so the motion reads
      // as the page settling, not as content arriving late.
      { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
    );

    for (const el of document.querySelectorAll('[data-reveal]')) {
      // An element with no box — `display: contents`, or a collapsed wrapper —
      // is never reported as intersecting, so hiding it would hide it for good.
      // Reveal it now, in this same task, so it never paints hidden.
      const box = el.getBoundingClientRect();
      if (box.width === 0 && box.height === 0) {
        el.classList.add('is-visible');
        continue;
      }
      observer.observe(el);
    }
  }
</script>
