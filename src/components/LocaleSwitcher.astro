---
import { locales, localeCodes, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Same page in each language. Built by the caller, which knows its own route. */
  hrefs: Record<Locale, string>;
  label: string;
}

const { locale, hrefs, label } = Astro.props;
const current = locales[locale];
---

<details class="switcher" data-dismissable>
  <summary aria-label={label}>
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      <ellipse cx="10" cy="10" rx="3.2" ry="7.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      <path d="M2.9 7.4h14.2M2.9 12.6h14.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <span class="current">{current.endonym}</span>
  </summary>
  <ul role="list" class="menu">
    {
      localeCodes.map((code) => (
        <li>
          <a
            href={hrefs[code]}
            hreflang={code}
            lang={code}
            dir={locales[code].dir}
            aria-current={code === locale ? 'true' : undefined}
          >
            {locales[code].endonym}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .switcher {
    position: relative;
  }

  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-block-size: 2.25rem;
    padding-inline: var(--space-sm);
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-sm);
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:is(:hover, :focus-visible) {
    border-color: var(--color-stroke-strong);
    color: var(--color-text-high);
  }

  summary svg {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    flex: none;
  }

  .current {
    /* Endonyms are their own script — never inherit the page's font stack. */
    font-family: system-ui, sans-serif;
  }

  .menu {
    position: absolute;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-end: 0;
    z-index: 30;
    min-inline-size: 11rem;
    margin: 0;
    padding: var(--space-2xs);
    display: grid;
    gap: 2px;
    border: 1px solid var(--color-stroke-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-high);
    box-shadow: var(--shadow-lift);
  }

  .menu a {
    display: block;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    font-family: system-ui, sans-serif;
  }

  .menu a:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--color-primary) 22%, transparent);
    color: var(--color-text-high);
  }

  .menu a[aria-current='true'] {
    color: var(--color-text-high);
    font-weight: 700;
    background: color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  /* On a phone the header is logo + language + download + menu, and the
     endonym is the one part that can be dropped without losing a control:
     "Bahasa Indonesia" next to "Télécharger" pushes the menu button off the
     edge of the screen. The globe stays, and summary keeps its aria-label. */
  @media (max-width: 48rem) {
    .current {
      display: none;
    }

    summary {
      /* Square, so it pairs with the menu button beside it. */
      justify-content: center;
      inline-size: 2.5rem;
      block-size: 2.5rem;
      padding-inline: 0;
    }

    summary svg {
      inline-size: 1.25rem;
      block-size: 1.25rem;
    }
  }
</style>

<script>
  // A <details> menu stays open on outside click and ignores Escape. Both are
  // expected of a dropdown, so add them — the menu is fully usable without.
  const close = (el: HTMLDetailsElement) => el.removeAttribute('open');

  document.addEventListener('click', (event) => {
    for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-dismissable][open]')) {
      if (!el.contains(event.target as Node)) close(el);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-dismissable][open]')) {
      close(el);
      el.querySelector('summary')?.focus();
    }
  });
</script>
