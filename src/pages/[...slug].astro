---
import Base from '../layouts/Base.astro';
import { copy, localizedPath, parseRoute, type Locale, type PageKey } from '../i18n/locales';

export function getStaticPaths() {
  const locales = Object.keys(copy) as Locale[];
  const pages: PageKey[] = ['home', 'features', 'download', 'support', 'privacy', 'terms', 'accountDeletion'];
  return locales.flatMap((locale) => pages.map((page) => {
    const path = localizedPath(locale, page).replace(/^\/|\/$/g, '');
    return { params: { slug: path || undefined } };
  }));
}

const slug = Astro.params.slug ? Astro.params.slug.split('/') : [];
const { locale, page } = parseRoute(slug);
const t = copy[locale];
const pageCopy = t[page];
const downloadCopy = t.download;
const title = page === 'home' ? 'Vidonzo' : `${pageCopy.title} | Vidonzo`;
const description = pageCopy.lead;
const storeLinks = {
  googlePlay: 'https://play.google.com/store/apps/details?id=com.vidonzo.player',
  appStore: 'https://apps.apple.com/app/id6792184222',
  androidMobileApk: 'https://dl.vidonzo.com/vidonzo-android-mobile-latest.apk',
  androidTvApk: 'https://dl.vidonzo.com/vidonzo-android-tv-latest.apk',
};
---
<Base locale={locale} page={page} title={title} description={description}>
  {page === 'home' ? (
    <section class="hero">
      <div class="hero-grid">
        <div>
          <div class="eyebrow">{t.home.eyebrow}</div>
          <h1>{t.home.title}</h1>
          <p class="lead">{t.home.lead}</p>
          <div class="actions">
            <a class="button" href={localizedPath(locale, 'download')}>{t.home.primary}</a>
            <a class="button secondary" href={localizedPath(locale, 'features')}>{t.home.secondary}</a>
          </div>
          <div class="signal-row">
            {t.home.sections.map((item) => <div class="signal">{item}</div>)}
          </div>
        </div>
        <figure class="hero-media">
          <img src="/assets/hero-devices.png" alt="" width="1536" height="864" loading="eager" />
        </figure>
      </div>
    </section>
  ) : (
    <section class="page">
      <div class="page-inner">
        <h1>{pageCopy.title}</h1>
        <p class="lead">{pageCopy.lead}</p>
        {page === 'download' ? (
          <div class="download-grid" aria-label="Vidonzo download options">
            <article class="download-card">
              <span class="download-icon android" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M8 7.4 6.4 4.8 5.2 5.5 6.8 8A6 6 0 0 0 5 12.3V19h14v-6.7A6 6 0 0 0 17.2 8l1.6-2.5-1.2-.7L16 7.4A7 7 0 0 0 8 7.4ZM8 11h1.4v1.4H8V11Zm6.6 0H16v1.4h-1.4V11Z" />
                </svg>
              </span>
              <span class="download-card-body">
                <strong>{downloadCopy.androidMobile}</strong>
                <small>{downloadCopy.androidMobileNote}</small>
                <span class="download-actions">
                  <a href={storeLinks.googlePlay} target="_blank" rel="noopener">{downloadCopy.googlePlay}</a>
                  <a href={storeLinks.androidMobileApk}>{downloadCopy.directApk}</a>
                </span>
              </span>
            </article>
            <a class="download-card" href={storeLinks.androidTvApk}>
              <span class="download-icon tv" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-6v2h3v1H7v-1h3v-2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Zm0 2v10h16V7H4Z" />
                </svg>
              </span>
              <span class="download-card-body">
                <strong>{downloadCopy.androidTv}</strong>
                <small>{downloadCopy.androidTvNote}</small>
              </span>
            </a>
            <a class="download-card" href={storeLinks.appStore} target="_blank" rel="noopener">
              <span class="download-icon app-store" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M16.7 2.2c.1 1.1-.3 2.2-1.1 3-.8.9-1.9 1.4-3 1.3-.1-1.1.3-2.1 1.1-3 .8-.8 2-1.4 3-1.3Z" />
                  <path d="M20.4 17.6c-.5 1.2-.8 1.7-1.5 2.8-1 1.5-2.3 3.4-4 3.4-1.5 0-1.9-1-3.9-1s-2.5 1-3.9 1c-1.7 0-3-1.7-4-3.2-2.7-4.2-3-9.1-1.3-11.7 1.2-1.8 3-2.8 4.7-2.8 1.8 0 2.9 1 4.4 1s2.4-1 4.4-1c1.5 0 3.2.8 4.4 2.3-3.9 2.1-3.3 7.6.7 9.2Z" />
                </svg>
              </span>
              <span class="download-card-body">
                <strong>{downloadCopy.iphone}</strong>
                <small>{downloadCopy.iphoneNote}</small>
              </span>
            </a>
            <article class="download-card disabled-card" aria-disabled="true">
              <span class="download-icon desktop" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M3 5h18v11H3V5Zm2 2v7h14V7H5Zm4 11h6l1 2H8l1-2Z" />
                </svg>
              </span>
              <span class="download-card-body">
                <strong>{downloadCopy.macos}</strong>
                <small>{downloadCopy.macosNote}</small>
                <em>{downloadCopy.comingSoon}</em>
              </span>
            </article>
            <article class="download-card disabled-card" aria-disabled="true">
              <span class="download-icon windows" aria-hidden="true">
                <svg viewBox="0 0 24 24" role="img">
                  <path d="M3 5.5 11 4v7H3V5.5Zm10-1.8 8-1.5V11h-8V3.7ZM3 13h8v7l-8-1.5V13Zm10 0h8v8.8l-8-1.5V13Z" />
                </svg>
              </span>
              <span class="download-card-body">
                <strong>{downloadCopy.windows}</strong>
                <small>{downloadCopy.windowsNote}</small>
                <em>{downloadCopy.comingSoon}</em>
              </span>
            </article>
          </div>
        ) : null}
        {page === 'support' && 'cta' in pageCopy ? <a class="support-card" href="mailto:support@vidonzo.com">{pageCopy.cta}</a> : null}
      </div>
    </section>
  )}
</Base>
