---
import Base from '../../../layouts/Base.astro';
import AuroraBackground from '../../../components/AuroraBackground.astro';
import Reveal from '../../../components/Reveal.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Button from '../../../components/Button.astro';
import { localeRoutes, type LocaleRouteProps } from '../../../i18n/routing';
import { getLocalizedCollection } from '../../../i18n/content';
import { defaultLocale, locales, localizedPath, useTranslations } from '../../../i18n';
import { site } from '../../../config/site';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as LocaleRouteProps;
const t = useTranslations(locale);

const guides = await getLocalizedCollection('help', locale);

// Categories are rendered in a deliberate order — install first, fix last —
// rather than alphabetically, which would scatter the reading path.
const categoryOrder = ['setup', 'playlists', 'television', 'account', 'troubleshooting'] as const;
const categoryLabels: Record<(typeof categoryOrder)[number], string> = {
  setup: t.home.setupTitle,
  playlists: t.features.groups[0].title,
  television: t.features.groups[4].title,
  account: t.legal.accountDeletion,
  troubleshooting: t.help.stillStuck,
};

const grouped = categoryOrder
  .map((category) => ({
    category,
    label: categoryLabels[category],
    items: guides
      .filter((guide) => guide.entry.data.category === category)
      .sort((a, b) => a.entry.data.order - b.entry.data.order),
  }))
  .filter((group) => group.items.length > 0);
---

<Base
  locale={locale}
  active="help"
  title={`${t.help.title} | ${site.name}`}
  description={t.help.lead}
>
  <section class="page-head">
    <AuroraBackground subtle />
    <div class="container head-inner">
      <Reveal>
        <h1>{t.help.title}</h1>
        <p class="lead">{t.help.lead}</p>
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        grouped.length === 0 ? (
          <p class="empty">{t.help.empty}</p>
        ) : (
          grouped.map((group) => (
            <div class="group">
              <h2>{group.label}</h2>
              <div class="grid">
                {group.items.map((guide, index) => (
                  <ArticleCard
                    href={localizedPath(locale, 'help', guide.slug)}
                    title={guide.entry.data.title}
                    description={guide.entry.data.description}
                    delay={index % 3}
                    contentLang={guide.isFallback ? defaultLocale : undefined}
                    contentDir={guide.isFallback ? locales[defaultLocale].dir : undefined}
                  />
                ))}
              </div>
            </div>
          ))
        )
      }

      <Reveal>
        <aside class="stuck">
          <div>
            <h2>{t.help.stillStuck}</h2>
            <p>{t.help.stillStuckLead}</p>
          </div>
          <Button href={localizedPath(locale, 'support')} variant="ghost">{t.nav.support}</Button>
        </aside>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  .page-head {
    position: relative;
    padding-block: var(--space-3xl) var(--space-lg);
    overflow: hidden;
  }

  .head-inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: var(--text-3xl);
    margin-block-end: var(--space-md);
  }

  .section {
    padding-block-start: var(--space-xl);
  }

  .group + .group {
    margin-block-start: var(--space-2xl);
  }

  .group h2 {
    margin-block-end: var(--space-md);
    font-size: var(--text-xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-md);
  }

  .empty {
    color: var(--color-text-mid);
  }

  .stuck {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 65%, transparent);
  }

  .stuck h2 {
    font-size: var(--text-lg);
  }

  .stuck p {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-mid);
    font-size: var(--text-sm);
  }
</style>
