---
import Base from '../../layouts/Base.astro';
import AuroraBackground from '../../components/AuroraBackground.astro';
import Reveal from '../../components/Reveal.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import Button from '../../components/Button.astro';
import { localeRoutes, type LocaleRouteProps } from '../../i18n/routing';
import { localizedPath, useTranslations } from '../../i18n';
import { site, storeLinks } from '../../config/site';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as LocaleRouteProps;
const t = useTranslations(locale);
const d = t.download;
---

<Base
  locale={locale}
  active="download"
  title={`${d.title} | ${site.name}`}
  description={d.lead}
>
  <section class="page-head">
    <AuroraBackground subtle />
    <div class="container head-inner">
      <Reveal>
        <h1>{d.title}</h1>
        <p class="lead">{d.lead}</p>
      </Reveal>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {/* Filled in by the platform sniff below; stays hidden when nothing matches. */}
      <div class="recommended" hidden data-recommended>
        <h2 class="eyebrow">{d.recommendedFor}</h2>
        <div class="slot" data-recommended-slot></div>
      </div>

      <h2 class="all-heading" data-all-heading hidden>{d.otherPlatforms}</h2>

      <div class="grid" data-grid>
        <Reveal>
          <DownloadCard
            platform="android"
            title={d.androidMobile}
            note={d.androidMobileNote}
            icon="android"
            tone="android"
            links={[
              { label: d.googlePlay, href: storeLinks.googlePlay, external: true },
              { label: d.directApk, href: storeLinks.androidMobileApk },
            ]}
          />
        </Reveal>

        <Reveal delay={1}>
          <DownloadCard
            platform="ios"
            title={d.iphone}
            note={d.iphoneNote}
            icon="apple"
            tone="apple"
            links={[{ label: d.appStore, href: storeLinks.appStore, external: true }]}
          />
        </Reveal>

        <Reveal delay={2}>
          <DownloadCard
            platform="androidtv"
            title={d.androidTv}
            note={d.androidTvNote}
            icon="tv"
            tone="tv"
            links={[{ label: d.directApk, href: storeLinks.androidTvApk }]}
          />
        </Reveal>

        <Reveal>
          <DownloadCard
            platform="macos"
            title={d.macos}
            note={d.macosNote}
            icon="desktop"
            tone="desktop"
            comingSoon={d.comingSoon}
          />
        </Reveal>

        <Reveal delay={1}>
          <DownloadCard
            platform="windows"
            title={d.windows}
            note={d.windowsNote}
            icon="windows"
            tone="windows"
            comingSoon={d.comingSoon}
          />
        </Reveal>
      </div>

      <Reveal delay={1}>
        <aside class="help">
          <div>
            <h2>{d.helpTitle}</h2>
            <p>{d.helpLead}</p>
          </div>
          <Button href={localizedPath(locale, 'help')} variant="ghost">{t.nav.help}</Button>
        </aside>
      </Reveal>
    </div>
  </section>
</Base>

<style>
  .page-head {
    position: relative;
    padding-block: var(--space-3xl) var(--space-lg);
    overflow: hidden;
  }

  .head-inner {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-size: var(--text-3xl);
    margin-block-end: var(--space-md);
  }

  .section {
    padding-block-start: var(--space-xl);
  }

  .recommended {
    margin-block-end: var(--space-2xl);
  }

  .recommended .eyebrow {
    margin-block-end: var(--space-sm);
  }

  .all-heading {
    margin-block-end: var(--space-md);
    color: var(--color-text-mid);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .grid,
  .slot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-md);
  }

  .help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
    padding: var(--space-lg);
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 65%, transparent);
  }

  .help h2 {
    font-size: var(--text-lg);
  }

  .help p {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-mid);
    font-size: var(--text-sm);
    max-inline-size: 44rem;
  }
</style>

<script>
  // Every platform stays listed and reachable; the sniff only lifts the likely
  // one to the top. Guessing wrong therefore costs a glance, not a download.
  const ua = navigator.userAgent;
  const platform =
    /Android/i.test(ua) && /TV|BRAVIA|AFT|SmartTV/i.test(ua)
      ? 'androidtv'
      : /Android/i.test(ua)
        ? 'android'
        : /iPhone|iPad|iPod/i.test(ua) ||
            // iPadOS reports as a Mac; a touch point tells the two apart.
            (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
          ? 'ios'
          : /Macintosh|Mac OS X/i.test(ua)
            ? 'macos'
            : /Windows/i.test(ua)
              ? 'windows'
              : null;

  const match = platform && document.querySelector(`[data-platform="${platform}"]`);
  // Promoting an unreleased platform would put "Coming soon" in the most
  // prominent slot on the page and give the visitor nothing to click. A Mac
  // user is better served by the full list until the desktop build ships.
  const card = match?.getAttribute('aria-disabled') === 'true' ? null : match;

  const region = document.querySelector<HTMLElement>('[data-recommended]');
  const slot = document.querySelector('[data-recommended-slot]');
  const allHeading = document.querySelector<HTMLElement>('[data-all-heading]');

  if (card && region && slot && allHeading) {
    // Move the wrapper, not the card, so the reveal animation stays attached.
    slot.append(card.closest('[data-reveal]') ?? card);
    region.hidden = false;
    allHeading.hidden = false;
  }
</script>
